flowchart TB
chief["chief-of-staff: long-running goal"] --> env["Improve constraints, standards, checks and data access before<br/>task work"] --> tactical["Delegate scoped tactical tasks via context pointers; retain<br/>strategic view"] --> strategy["Inspect outcomes; improve environment; suggest supported<br/>schedules"] --> env
 looph["loop-me: interview thin NOTES.md; discover recurring life / work<br/>loops"] --> interview["grilling: resolve trigger, human checkpoint, brief and desired<br/>outcome only as needed"] --> specs["Create / edit / delete workflows/*.md specs"] --> done{"Implementer can build without questions?"}
 done -->|no| interview
 done -->|yes| finished["Finished workflow spec; no execution implied"]
 hand["claude-handoff: focused redacted summary + suggested skills in<br/>private temp file"] --> capability{"Authorized background worker and supervisor available?"}
 capability -->|yes| launch["Launch fresh worker with done check, time budget, logs and stop<br/>path"]
 capability -->|no| file["Return handoff path and fresh-session instructions; no job<br/>launched"]
 ts["setup-ts-deep-modules: detect environment; install<br/>dependency-cruiser"] --> config["Configure entrypoint imports, public-seam tests, internal<br/>freedom and no cycles"] --> wire["Wire checks; scaffold example"] --> prove["Clean pass → temporary deep-import failure → revert → pass"] --> document["Document boundary convention"]
 fragments["writing-fragments: interview from first prompt; mine raw<br/>material"] --> pile["Append fragments to one file; reread before writes; preserve<br/>author edits"]
 pile --> more["Keep exploring; no outline or committed structure"] --> fragments
 pile --> choice{"Ready to exploit fixed pile?"}
 choice --> shape["writing-shape: read whole pile; agree audience prerequisites;<br/>show 2–3 openings; user chooses"] --> block["Choose next grounded block and format; append agreed block<br/>immediately"] --> shapeend{"User says article done?"}
 shapeend -->|no: reread and preserve edits| block
 shapeend -->|yes| article["Separate finished article; raw pile unchanged"]
 choice --> beats["writing-beats: agree prerequisites; offer 2–3 starting beats"] --> pick["User picks reachable beat; append only that beat; update<br/>grounded concepts"] --> beatend{"Journey at natural end?"}
 beatend -->|no| offer["Reread article; offer 2–3 reachable next beats and concepts each<br/>grounds"] --> pick
 beatend -->|yes| article
