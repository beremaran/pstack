incoming["triage: incoming issues / external PRs; inspect prior notes,<br/>code, redundancy and rejected requests"] --> recommend["Recommend bug / enhancement category and state; await maintainer<br/>direction"] --> verify["Verify bug report / attached PR; grill and domain-model if<br/>needed"] --> outcome{"One category + one state"}
 outcome --> info["needs-info: established facts + concrete open questions"] -->|reporter reply| again["needs-triage: reevaluate; retain resolved answers"] --> incoming
 outcome --> ready["ready-for-agent: durable agent brief"] --> implement["implement"]
 outcome --> human["ready-for-human: brief explains human-only work"]
 outcome --> wont["wontfix: close with reason; rejected enhancement →<br/>.out-of-scope;<br/>already implemented → point to code, no rejection entry"]
 outcome --> again
 override["Maintainer direct state override"] --> direct["Confirm changes and apply directly; skip grilling; offer brief<br/>if agent-ready"]
 bug["diagnosing-bugs"] --> loop["Build one tight command that demonstrably goes red; redact<br/>secrets"] --> minimize["Reproduce and minimize while preserving failure"] --> hypothesis["Rank falsifiable hypotheses"] --> instrument["Instrument distinguishing boundaries; test prediction"] --> proven{"Mechanism confirmed?"}
 proven -->|no| hypothesis
 proven -->|yes| red["Minimized regression test goes red"] --> fix["Fix; test green; original un-minimized scenario green"] --> cleanup["Remove diagnostics; report mechanism and proof"] --> retro["retro in same session"]
 fog["wayfinder: huge foggy effort"] --> map["Shared map of linked decision tickets"] --> decide["Resolve one decision frontier; grilling; record primary sources<br/>and decisions"] --> clear{"Build path clear?"}
 clear -->|no| map
 clear -->|yes| spec["to-spec collapses decisions → to-tickets → implement /<br/>implement-spec"]
 clear -->|effort genuinely small| implement
 health["improve-codebase-architecture: explore for deepening<br/>opportunities"] --> report["HTML candidate report; flag justified ADR conflicts"] --> choose["Grill selected candidate using codebase-design vocabulary"] --> idea["Idea → grill-with-docs → main flow"]
